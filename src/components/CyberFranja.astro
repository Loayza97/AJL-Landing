---
// Franja fija de la campaña Cyber Wow: «Hasta X% de descuento», contador y, en la
// portada, el botón «Ver ofertas». Va como primer elemento de la página. Al vencer
// (CYBER_FIN) marca <html data-cw="off"> y todo lo de la campaña se oculta.
import '../styles/cyberwow.css';
import { CYBER_FIN, descuentoMaxGlobal } from '../data/cyberwow.js';
const { boton = false } = Astro.props;
const pct = descuentoMaxGlobal();
---
<div class="cw-franja" role="region" aria-label="Oferta Cyber Wow">
  <strong>Cyber Wow</strong>
  <span>Hasta {pct}% de descuento en tus paquetes</span>
  <span class="cw-timer" role="timer" aria-live="off"></span>
  {boton && <a href="#section-packages">Ver ofertas</a>}
</div>
<script is:inline define:vars={{ fin: CYBER_FIN }}>
  (function () {
    var limite = Date.parse(fin), raiz = document.documentElement;
    function apagar() { raiz.setAttribute('data-cw', 'off'); }
    if (Date.now() >= limite) { apagar(); return; }
    function dos(n) { return (n < 10 ? '0' : '') + n; }
    function pintar() {
      var s = Math.floor((limite - Date.now()) / 1000);
      if (s <= 0) { apagar(); return false; }
      var t = Math.floor(s / 86400) + ' d ' + dos(Math.floor(s % 86400 / 3600)) + ' h ' + dos(Math.floor(s % 3600 / 60)) + ' m ' + dos(s % 60) + ' s';
      var e = document.querySelectorAll('.cw-timer');
      for (var i = 0; i < e.length; i++) e[i].textContent = t;
      return true;
    }
    if (pintar()) {
      // los contadores de más abajo (planes) todavía no existen: se vuelven a pintar al cargar
      document.addEventListener('DOMContentLoaded', pintar);
      var iv = setInterval(function () { if (!pintar()) clearInterval(iv); }, 1000);
    }
  })();
</script>
