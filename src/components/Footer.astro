---
import { contacto } from '../data/contacto.js';
---

<footer id="section-footer" class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__logo">AJL Nutrición</p>
      <p class="footer__tagline">Nutricionista en Lince, Lima · Estructura para tu vida real.</p>
      <p class="footer__location">{contacto.direccion}</p>
    </div>

    <div class="footer__legal">
      <p class="footer__copy">
        © {new Date().getFullYear()} AJL Nutrición. Todos los derechos reservados.
      </p>
      <p class="footer__privacy">
        <a href="/privacidad/" class="footer__legal-link">Política de privacidad</a>
      </p>
      <a href="/reclamaciones/" class="footer__reclamaciones" aria-label="Libro de Reclamaciones">
        <span class="footer__reclamaciones-icon" aria-hidden="true">📕</span>
        Libro de Reclamaciones
      </a>
      <p class="footer__disclaimer">
        Los resultados individuales varían según el caso y la constancia de cada paciente.
        AJL Nutrición no garantiza resultados específicos de pérdida de peso.
      </p>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--verde-osc);
  color: var(--white);
  padding-block: 3.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: start;
  gap: 2.5rem;
}

.footer__brand {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.footer__logo {
  font-size: 1.2rem;
  font-weight: 900;
  color: var(--gold);
  letter-spacing: -0.3px;
}

.footer__tagline {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.62);
  font-style: italic;
}

.footer__location {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.5px;
}

.footer__links {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.footer__wa-btn {
  gap: 0.625rem;
}

.footer__legal {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  text-align: right;
}

.footer__copy {
  font-size: 0.78rem;
  color: rgba(255, 255, 255, 0.5);
}

.footer__privacy {
  font-size: 0.78rem;
  color: rgba(255, 255, 255, 0.5);
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}

.footer__legal-link {
  color: rgba(255, 255, 255, 0.6);
  transition: color var(--transition);
}

.footer__legal-link:hover { color: var(--gold); }

/* Libro de Reclamaciones (obligatorio, visible) */
.footer__reclamaciones {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  align-self: flex-end;
  margin-top: 0.25rem;
  padding: 0.4rem 0.85rem;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  transition: border-color var(--transition), color var(--transition);
}

.footer__reclamaciones:hover { border-color: var(--gold); color: var(--gold); }
.footer__reclamaciones-icon { font-size: 0.95rem; }

.footer__disclaimer {
  font-size: 0.7rem;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.5;
  max-width: 280px;
  margin-left: auto;
}

@media (max-width: 768px) {
  .footer__inner {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .footer__legal { text-align: center; align-items: center; }
  .footer__privacy { justify-content: center; }
  .footer__reclamaciones { align-self: center; }
  .footer__disclaimer { margin-inline: auto; }
}
</style>
