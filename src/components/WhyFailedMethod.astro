---
// ─── Sección 2: Diagnóstico → Método ────────────────────────────────────────
// Un solo arco: "por qué fallaste antes" fluye directo a "cómo lo resolvemos".
// Reemplaza a WhyFailed.astro + Method.astro (eliminados de index.astro).

const rows = [
  { says: '"No tengo disciplina"',          real: 'Internalizaste un modelo restrictivo que nunca fue sostenible' },
  { says: '"No puedo seguir dietas"',        real: 'Los planes que te dieron ignoraban tu rutina real' },
  { says: '"Siempre vuelvo a subir"',        real: 'Nunca te enseñaron estructura aplicable a tu vida' },
  { says: '"No tengo fuerza de voluntad"',   real: 'Los métodos previos no se adaptaban a tu contexto' },
  { says: '"Soy un caso difícil"',           real: 'Tu caso es normal. El modelo que usaste no lo era' },
];

const steps = [
  {
    n: '01',
    title: 'Estructura en tu vida real',
    desc: 'Partimos de tu rutina como es —3 comidas + 1 snack, lo que ya haces— y la ordenamos. No copiamos la vida ideal de otro.',
  },
  {
    n: '02',
    title: 'Planificación semanal',
    desc: 'Cada semana planificamos juntos. Ajustamos según lo que viene: un viaje, cenas de trabajo, una semana de caos.',
  },
  {
    n: '03',
    title: 'Gestión de porciones visible',
    desc: 'Aprendes a medir con manos, tazas y platos —sin pesar gramos ni contar calorías. Una habilidad para toda la vida.',
  },
  {
    n: '04',
    title: 'Backend calórico oculto',
    desc: 'Nosotros calculamos calorías y macros. Tú solo sigues las porciones. El fondo se gestiona sin que lo sientas como restricción.',
  },
  {
    n: '05',
    title: 'Acompañamiento cercano',
    desc: 'Seguimiento frecuente, no una consulta mensual y suerte. Estamos presentes entre sesiones para la duda del día a día.',
  },
  {
    n: '06',
    title: 'Ajuste según adherencia real',
    desc: 'No exigimos perfección desde el día 1. Ajustamos a lo que puedes sostener hoy y lo escalamos. El progreso es real o no sirve.',
  },
];
---

<section id="section-why-failed" class="section bg-white diagnosis">
  <div class="container">
    <p class="label">Por qué no funcionó antes</p>
    <h2 class="title" style="max-width: 620px; margin-bottom: 1rem;">
      "¿Por qué tú sí,<br />si ya muchos fallaron conmigo?"
    </h2>
    <p class="subtitle" style="margin-bottom: 3rem;">
      Es la pregunta que todos se hacen antes de intentarlo de nuevo. La respuesta no está
      en tu disciplina: está en que los métodos anteriores te dieron un plan para una vida
      que no es la tuya.
    </p>

    <div class="table-wrapper" role="table" aria-label="Comparación de creencias vs realidad">
      <div class="table-head" role="row">
        <div role="columnheader">Lo que piensas</div>
        <div role="columnheader" class="real-col">El problema real</div>
      </div>
      {rows.map(row => (
        <div class="table-row" role="row">
          <div class="table-cell says" role="cell">{row.says}</div>
          <div class="table-cell real" role="cell">{row.real}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="section-method" class="section bg-black method">
  <div class="container">
    <p class="bridge">
      Por eso construimos el proceso al revés:<br />
      <span>empezamos por tu vida, no por un plan ideal.</span>
    </p>

    <p class="label">El método AJL</p>
    <h2 class="title white" style="margin-bottom: 0.75rem;">
      6 pasos para una estructura<br />que dura más de 30 días.
    </h2>
    <p class="subtitle light" style="margin-bottom: 3.5rem;">
      Cada paso parte de cómo ya vives, no de cómo "deberías" vivir.
    </p>

    <div class="steps-grid">
      {steps.map(step => (
        <div class="step-card">
          <span class="step-n">{step.n}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <div style="text-align: center; margin-top: 3rem;">
      <a
        href="#section-packages"
        class="btn-primary"
        data-cta="method_primary"
        aria-label="Ver los paquetes disponibles"
      >
        Ver los paquetes →
      </a>
    </div>
  </div>
</section>

<style>
.bg-white { background: var(--white); }
.bg-black { background: var(--black); }
.white    { color: var(--white); }
.light    { color: #aaaaaa; }

/* ── Diagnóstico: tabla creencia vs realidad ── */
.table-wrapper {
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  overflow: hidden;
}

.table-head {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--black);
  padding: 1rem 1.5rem;
  gap: 1rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #888;
}

.table-head .real-col { color: var(--gold); }

.table-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  padding: 1.1rem 1.5rem;
  border-top: 1px solid #eeeeee;
  transition: background var(--transition);
}

.table-row:hover { background: var(--gray-light); }

.table-cell {
  font-size: 0.95rem;
  line-height: 1.5;
  align-self: center;
}

.table-cell.says {
  color: var(--gray-dark);
  font-style: italic;
}

.table-cell.real {
  color: var(--black);
  font-weight: 600;
}

/* ── Puente diagnóstico → método ── */
.bridge {
  font-size: clamp(1.15rem, 3vw, 1.6rem);
  font-weight: 800;
  line-height: 1.4;
  color: #666;
  margin-bottom: 3.5rem;
  letter-spacing: -0.4px;
}

.bridge span { color: var(--gold); }

/* ── Método: grid de pasos ── */
.steps-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

.step-card {
  border: 1px solid #222222;
  border-radius: 8px;
  padding: 1.75rem;
  transition: border-color var(--transition);
}

.step-card:hover { border-color: var(--gold); }

.step-n {
  display: block;
  font-size: 3rem;
  font-weight: 900;
  color: var(--gold);
  line-height: 1;
  margin-bottom: 0.75rem;
  letter-spacing: -2px;
}

.step-title {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--white);
  margin-bottom: 0.625rem;
  letter-spacing: -0.2px;
}

.step-desc {
  font-size: 0.9rem;
  color: #999999;
  line-height: 1.65;
}

@media (max-width: 640px) {
  .table-head,
  .table-row { grid-template-columns: 1fr; }
  .table-head .real-col { display: none; }

  .table-cell.says::before {
    content: 'Lo que piensas: ';
    font-style: normal;
    font-weight: 700;
    color: #888;
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .table-cell.real::before {
    content: 'El problema real: ';
    font-weight: 700;
    color: var(--gold);
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .steps-grid { grid-template-columns: 1fr; }
}
</style>
