---
// ─── Plan Parejas: producto de lanzamiento (22-nov-2026) ────────────────────
// Réplica web del banner aprobado «banner-parejas» (banner-precios-v2), con la
// misma paleta blanco y oro de Plans.astro. Va en la portada justo después de
// los planes individuales; arriba de esos planes hay un aviso «Nuevo» que trae
// hasta acá (#section-parejas).
//
// Reglas que no se deben romper:
//   - Textos iguales al banner. Lo único que no está en el banner es el botón
//     («Quiero el Plan Parejas →») y la etiqueta «Nuevo» (decisión del 22-nov).
//   - Precio por persona en grande; el de los dos, chico debajo.
//   - Sin tachados, sin porcentajes, sin urgencia, nunca «el más elegido».
//   - «★ Recomendado» solo en el de 7 sesiones, como en el banner.
//   - Se compra por WhatsApp (no hay checkout para dos personas). El botón usa
//     data-wa-section / data-wa-pkg / data-wa-msg: Layout.astro arma el link y
//     registra la conversión (GA4, Meta Lead y /api/conversion).
import { planParejas as pp, paymentMethods } from '../data/plans.js';
import { WA_NUMBER } from '../config.js';

const waHref = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(pp.waMensaje)}`;
---

<section id="section-parejas" class="ajl-parejas" aria-labelledby="pp-titulo">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
    <symbol id="pp-i-chat" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 3.5V17.5H4A1.5 1.5 0 0 1 2.5 16V7A1.5 1.5 0 0 1 4 5.5Z"/><path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01" stroke-width="2.4"/></g></symbol>
    <symbol id="pp-i-group" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3"/><circle cx="5.5" cy="10" r="2.2"/><circle cx="18.5" cy="10" r="2.2"/><path d="M6.5 19.5v-1.5a5.5 5.5 0 0 1 11 0v1.5M1.8 19.5V18a3.7 3.7 0 0 1 4.6-3.6M22.2 19.5V18a3.7 3.7 0 0 0-4.6-3.6"/></g></symbol>
    <symbol id="pp-i-cal" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M7.5 14h.01M12 14h.01M16.5 14h.01M7.5 17.5h.01M12 17.5h.01" stroke-width="2.2"/></g></symbol>
    <symbol id="pp-i-phone" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6.5" y="2.5" width="11" height="19" rx="2.2"/><path d="M10.5 18.5h3"/></g></symbol>
  </defs></svg>

  <div class="pp-inner">
    <div class="pp-caja">
      <header class="pp-top">
        <span class="pp-nuevo">{pp.badge}</span>
        <h2 class="pp-hl" id="pp-titulo">{pp.name}</h2>
        <p class="pp-sub">{pp.tagline}</p>
      </header>

      <p class="pp-sec">3 meses <em>· en cuotas mensuales</em></p>
      <div class="pp-dos">
        {pp.paquetes.map(o => (
          <div class:list={['pp-op', { 'pp-op--star': o.highlight }]}>
            {o.highlight && <span class="pp-tag">{pp.badgeRecomendado}</span>}
            <span class="pp-n">{o.sesiones} sesiones</span>
            <span class="pp-f">{o.frecuencia[0]}<br />{o.frecuencia[1]}</span>
            <span class="pp-hr" aria-hidden="true"></span>
            <span class="pp-p"><span class="pp-cu">S/</span>{o.cadaUno}</span>
            <span class="pp-e">al mes, cada uno</span>
            <small>S/{o.losDos} al mes los dos</small>
          </div>
        ))}
      </div>

      <p class="pp-sec">1 mes <em>· sin paquete</em></p>
      <div class="pp-uno">
        <div>
          <span class="pp-n">{pp.mesSuelto.sesiones} sesiones</span>
          <span class="pp-f">{pp.mesSuelto.detalle}</span>
        </div>
        <div class="pp-r">
          <span class="pp-p"><span class="pp-cu">S/</span>{pp.mesSuelto.cadaUno}</span>
          <span class="pp-e">cada uno</span>
          <small>S/{pp.mesSuelto.losDos} los dos</small>
        </div>
      </div>

      <div class="pp-btw">
        <h3>Entre sesión y sesión, <span>no se quedan solos</span></h3>
        <ul>
          {pp.entreSesiones.map(i => (
            <li><svg aria-hidden="true"><use href={`#pp-i-${i.icon}`}/></svg>{i.text}</li>
          ))}
        </ul>
      </div>

      <p class="pp-nota">{pp.nota}</p>

      <a
        href={waHref}
        class="pp-btn"
        data-wa-section="parejas"
        data-wa-pkg={pp.name}
        data-wa-msg={pp.waMensaje}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Quiero el Plan Parejas: escribir por WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Quiero el Plan Parejas →
      </a>

      <div class="pp-pago">
        <span class="pp-pago-lab">Formas de pago</span>
        <div class="pp-pills">{paymentMethods.map(m => <span>{m.label}</span>)}</div>
      </div>
    </div>
  </div>
</section>

<style>
/* Misma paleta blanco y oro de Plans.astro y del banner */
.ajl-parejas {
  --ink: #111111; --muted: #6B6B6B; --hair: #E4E4E4; --paper: #FFFFFF; --soft: #F4F4F2;
  --gold: #C9A24B; --gold-ink: #9C7A2B;
  --ff: "Montserrat", "Helvetica Neue", Arial, sans-serif;
  font-family: var(--ff);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  font-variant-numeric: tabular-nums;
  scroll-margin-top: 16px;
}
.ajl-parejas * { box-sizing: border-box; }
.ajl-parejas h2, .ajl-parejas h3, .ajl-parejas p { margin: 0; font-family: var(--ff); color: inherit; }
.pp-inner { max-width: 880px; margin: 0 auto; padding: 8px 20px 56px; }
.pp-caja {
  position: relative; max-width: 620px; margin: 0 auto;
  border: 1.5px solid var(--gold); border-radius: 16px;
  padding: 34px 26px 26px;
  display: flex; flex-direction: column; gap: 16px;
}

/* Cabecera */
.pp-top { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
.pp-nuevo {
  position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%);
  font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
  color: #fff; background: var(--gold-ink); border-radius: 99px; padding: 6px 14px; white-space: nowrap;
}
.ajl-parejas .pp-hl { font-size: clamp(28px, 5vw, 40px); font-weight: 800; letter-spacing: -.035em; line-height: 1.06; }
.pp-hl::after { content: ""; display: block; width: 52px; height: 3px; background: var(--gold); border-radius: 2px; margin: 12px auto 0; }
.ajl-parejas .pp-sub { font-size: 16px; color: var(--muted); line-height: 1.4; max-width: 440px; text-wrap: balance; }

/* Separadores «3 MESES · en cuotas mensuales» */
.ajl-parejas .pp-sec { display: flex; align-items: center; gap: 10px; margin-top: 4px; font-size: 13px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; white-space: nowrap; }
.pp-sec::after { content: ""; flex: 1; height: 1px; background: var(--hair); }
.pp-sec em { font-style: normal; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--muted); font-size: 13.5px; }

/* Las dos opciones de 3 meses */
.pp-dos { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.pp-op { position: relative; border: 1px solid var(--hair); border-radius: 12px; padding: 22px 12px 16px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; }
.pp-op--star { border: 1.5px solid var(--gold); background: var(--soft); }
.pp-tag { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); font-size: 12px; font-weight: 700; color: #fff; background: var(--gold-ink); border-radius: 99px; padding: 4px 11px; white-space: nowrap; }
.pp-n { font-size: 24px; font-weight: 800; letter-spacing: -.03em; line-height: 1.05; }
.pp-f { display: block; font-size: 13.5px; color: var(--muted); line-height: 1.3; }
.pp-op .pp-f { min-height: 2.6em; }
.pp-hr { width: 60%; height: 1px; background: var(--hair); margin: 6px 0; }
.pp-p { display: block; font-size: 38px; font-weight: 800; letter-spacing: -.035em; line-height: 1; white-space: nowrap; }
.pp-cu { font-size: .55em; letter-spacing: 0; margin-right: 1px; }
.pp-e { display: block; font-size: 14px; font-weight: 700; color: var(--gold-ink); }
.ajl-parejas small { display: block; font-size: 13px; color: var(--muted); line-height: 1.3; margin-top: 2px; }

/* 1 mes, sin paquete */
.pp-uno { border: 1px solid var(--hair); border-radius: 12px; padding: 14px 18px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 12px; }
.pp-uno .pp-n { display: block; font-size: 21px; }
.pp-uno .pp-f { margin-top: 4px; }
.pp-r { text-align: right; display: flex; flex-direction: column; gap: 2px; }
.pp-uno .pp-p { font-size: 32px; }

/* Entre sesión y sesión */
.pp-btw { background: var(--soft); border-radius: 12px; padding: 16px 18px; display: flex; flex-direction: column; gap: 12px; }
.ajl-parejas .pp-btw h3 { font-size: 18px; font-weight: 800; letter-spacing: -.02em; line-height: 1.2; }
.pp-btw h3 span { color: var(--gold-ink); }
.pp-btw ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
.pp-btw li { display: flex; align-items: center; gap: 10px; font-size: 15px; line-height: 1.3; }
.pp-btw svg { width: 28px; height: 28px; flex: none; color: var(--gold-ink); }

.ajl-parejas .pp-nota { font-size: 14px; color: var(--muted); line-height: 1.4; text-align: center; }

/* Botón a WhatsApp, con el dorado del plan recomendado */
.pp-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  width: 100%; min-height: 52px; padding: 12px 18px; border-radius: 10px;
  font-family: var(--ff); font-size: 16px; font-weight: 700; text-decoration: none;
  color: #fff; background: var(--gold-ink); border: 1.5px solid var(--gold-ink);
  transition: transform .15s ease;
}
.pp-btn:hover { transform: translateY(-1px); }
.pp-btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

/* Formas de pago */
.pp-pago { display: flex; flex-direction: column; gap: 10px; align-items: center; }
.pp-pago-lab { font-size: 12px; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; }
.pp-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.pp-pills span { border: 1px solid #CFCFCF; border-radius: 10px; padding: 8px 16px; font-size: 14.5px; font-weight: 700; }

@media (max-width: 640px) {
  .pp-inner { padding: 4px 16px 40px; }
  .pp-caja { padding: 30px 14px 20px; gap: 14px; }
  .pp-dos { gap: 8px; }
  .pp-op { padding: 20px 8px 14px; }
  .pp-n { font-size: 21px; }
  .pp-f { font-size: 13px; }
  .pp-p { font-size: 34px; }
  .pp-e { font-size: 13px; }
  .pp-tag { font-size: 11.5px; padding: 4px 9px; }
  .pp-uno { padding: 12px 14px; }
  .pp-uno .pp-n { font-size: 19px; }
  .pp-uno .pp-p { font-size: 28px; }
  .pp-btw { padding: 14px; }
  .ajl-parejas .pp-btw h3 { font-size: 16.5px; }
  .pp-btw ul { grid-template-columns: minmax(0, 1fr); gap: 10px; }
  .pp-btw li { font-size: 14.5px; }
  .pp-btw svg { width: 26px; height: 26px; }
}
@media (prefers-reduced-motion: reduce) {
  .pp-btn { transition: none; }
  .pp-btn:hover { transform: none; }
}
</style>
