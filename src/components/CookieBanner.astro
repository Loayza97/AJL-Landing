<!-- Cookie banner (US-021) — oculto por defecto, JS lo muestra si no hay consentimiento -->
<div id="cookie-banner" class="cookie-banner" style="display: none;" role="alertdialog" aria-label="Aviso de cookies">
  <p class="cookie-banner__text">
    Usamos cookies para entender qué te sirve de esta página y para medir nuestros anuncios.
    <strong>Ninguna se activa hasta que aceptes</strong>, y puedes cambiar de opinión cuando quieras
    desde el pie de página. Más detalle en la
    <a href="/privacidad/" class="cookie-banner__link">política de privacidad</a>.
  </p>
  <div class="cookie-banner__acciones">
    <button id="cookie-reject" class="btn-outline cookie-banner__btn" aria-label="Rechazar cookies">
      Rechazar
    </button>
    <button id="cookie-accept" class="btn-primary cookie-banner__btn" aria-label="Aceptar cookies">
      Aceptar
    </button>
  </div>
</div>

<style>
.cookie-banner {
  position: fixed;
  bottom: 5.5rem;
  left: 1.5rem;
  right: 6rem;
  max-width: 560px;
  background: var(--verde-osc);
  color: var(--white);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 14px;
  padding: 1.25rem 1.5rem;
  z-index: 999;
  flex-direction: row;
  align-items: center;
  gap: 1.25rem;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
}

.cookie-banner__text {
  font-size: 0.82rem;
  color: #aaaaaa;
  line-height: 1.55;
  flex: 1;
}

.cookie-banner__link {
  color: var(--gold);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.cookie-banner__acciones {
  display: flex;
  gap: 0.625rem;
  flex-shrink: 0;
}

/* Mismo tamaño y prominencia en ambos: un "Rechazar" empequeñecido
   convierte la elección en decorativa y anula el consentimiento. */
.cookie-banner__btn {
  font-size: 0.85rem;
  padding: 0.625rem 1.25rem;
  min-height: 44px;
  flex: 1;
  white-space: nowrap;
}

@media (max-width: 600px) {
  .cookie-banner {
    left: 1rem;
    right: 1rem;
    bottom: 7rem;
    flex-direction: column;
    align-items: stretch;
  }

  .cookie-banner__acciones { width: 100%; }
}
</style>
