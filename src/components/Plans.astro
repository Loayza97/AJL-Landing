---
// ─── Planes: v2 blanco y oro (25-sep-2026) ──────────────────────────────────
// Réplica web del banner de precios v2 que el equipo manda por WhatsApp
// (paquete de Alejandro, «banner-precios-v2-para-joaquin»). Los precios no
// cambian respecto del modelo C; cambian el diseño y la presentación.
//
// Reglas de contenido que no se deben romper (README del banner):
//   - Sin nombres de plan: se dicen por sesiones al mes. «Acompañamiento
//     continuo» no es un plan, es lo que incluyen los tres.
//   - «+ 1 evaluación el primer mes» solo en 2 y 4 sesiones, con esas palabras.
//     Nunca «regalo» ni «bono».
//   - «El que recomendamos» aparece una sola vez (2 sesiones).
//   - Sin tachados, sin porcentajes (salvo el 5% de tarjeta), sin ahorro.
//   - La sesión única es «Compra única», nunca «/mes».
//   - Clases pbtn / data-section / data-pkg / aria-label: las usa la medición.
//   - Tipografía Montserrat 400–800 (reemplazo web de Gilroy), sin serifas.
import { monthlyPlans, singlePlan, includedInAll, paymentMethods } from '../data/plans.js';
---

<section id="section-packages" class="ajl-planes" aria-label="Planes de nutrición">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
    <symbol id="ap-i-chat" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 3.5V17.5H4A1.5 1.5 0 0 1 2.5 16V7A1.5 1.5 0 0 1 4 5.5Z"/><path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01" stroke-width="2.4"/></g></symbol>
    <symbol id="ap-i-group" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3"/><circle cx="5.5" cy="10" r="2.2"/><circle cx="18.5" cy="10" r="2.2"/><path d="M6.5 19.5v-1.5a5.5 5.5 0 0 1 11 0v1.5M1.8 19.5V18a3.7 3.7 0 0 1 4.6-3.6M22.2 19.5V18a3.7 3.7 0 0 0-4.6-3.6"/></g></symbol>
    <symbol id="ap-i-cal" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M7.5 14h.01M12 14h.01M16.5 14h.01M7.5 17.5h.01M12 17.5h.01" stroke-width="2.2"/></g></symbol>
    <symbol id="ap-i-phone" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6.5" y="2.5" width="11" height="19" rx="2.2"/><path d="M10.5 18.5h3"/></g></symbol>
  </defs></svg>

  <div class="ap-inner">
    <p class="ap-eyebrow">Planes</p>
    <h2 class="ap-hl">Estamos contigo durante todo el proceso</h2>

    <h3 class="ap-gt">Te acompañamos todo el mes</h3>
    <ul class="ap-incluye">
      {includedInAll.map(i => (
        <li><svg aria-hidden="true"><use href={`#ap-i-${i.icon}`}/></svg>{i.text}</li>
      ))}
    </ul>

    <div class="ap-tabla" role="table" aria-label="Precios por frecuencia de sesiones">
      <div class="ap-cab" role="row">
        <span role="columnheader">Tu plan</span>
        <span role="columnheader">1 mes</span>
        <span role="columnheader">3 meses</span>
        <span role="columnheader" aria-label="Elegir"></span>
      </div>

      {monthlyPlans.map(p => (
        <div class:list={['ap-fila', { 'ap-fila--star': p.highlight }]} role="row">
          {p.badge && <span class="ap-tag">✦ {p.badge}</span>}
          <div class="ap-plan" role="rowheader">
            <span class="ap-k">Acompañamiento continuo</span>
            <b>+ {p.name}</b>
            {p.firstMonthEval && <span class="ap-eval">+ 1 evaluación el primer mes</span>}
          </div>
          <div class="ap-precio" role="cell">
            <span class="ap-lbl">1 mes</span>
            <span class="ap-pr"><span class="ap-cu">S/</span>{p.price}</span>
          </div>
          <div class="ap-precio" role="cell">
            <span class="ap-lbl">3 meses</span>
            <span class="ap-pr"><span class="ap-cu">S/</span>{p.programs[0].total.replace('S/', '')}</span>
            <span class="ap-eq">{p.programs[0].perMes}</span>
          </div>
          <div class="ap-cta" role="cell">
            <a
              href={`/checkout/${p.id}`}
              class:list={['pbtn', { 'pbtn--star': p.highlight }]}
              data-section="paquetes"
              data-pkg={p.name}
              aria-label={`Quiero ${p.name}`}
            >Quiero este →</a>
          </div>
        </div>
      ))}
    </div>

    <p class="ap-nota"><b>La evaluación:</b> al cierre del primer mes medimos tu avance y decides cómo sigues.</p>

    <div class="ap-sola">
      <div><h4>{singlePlan.name}</h4><p>{singlePlan.tagline}.</p></div>
      <div class="ap-precio">
        <span class="ap-pr"><span class="ap-cu">S/</span>{singlePlan.price}</span>
        <span class="ap-eq">Compra única</span>
      </div>
      <div class="ap-cta">
        <a
          href={`/checkout/${singlePlan.id}`}
          class="pbtn pbtn--ghost"
          data-section="paquetes"
          data-pkg={singlePlan.name}
          aria-label="Quiero una sola sesión"
        >Quiero esta →</a>
      </div>
    </div>

    <div class="ap-pago">
      <span class="ap-pago-lab">Formas de pago</span>
      <div class="ap-pills">
        {paymentMethods.map(m => (
          <span>{m.label}{m.note && <em>{m.note}</em>}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* Paleta blanco y oro del banner v2, solo dentro de esta sección */
.ajl-planes {
  --ink: #111111; --muted: #6B6B6B; --hair: #E4E4E4; --paper: #FFFFFF;
  --gold: #C9A24B; --gold-ink: #9C7A2B;
  --ff: "Montserrat", "Helvetica Neue", Arial, sans-serif;
  font-family: var(--ff);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
}
.ap-inner {
  max-width: 880px; margin: 0 auto; padding: 56px 20px;
  display: flex; flex-direction: column; gap: 22px;
}
.ajl-planes * { box-sizing: border-box; }
.ajl-planes h2, .ajl-planes h3, .ajl-planes h4, .ajl-planes p { margin: 0; font-family: var(--ff); color: inherit; }

.ajl-planes .ap-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-ink); text-align: center; }
.ajl-planes .ap-hl { font-size: clamp(28px, 5vw, 40px); font-weight: 800; letter-spacing: -.035em; line-height: 1.06; text-align: center; text-wrap: balance; }
.ap-hl::after { content: ""; display: block; width: 52px; height: 3px; background: var(--gold); border-radius: 2px; margin: 14px auto 0; }
.ajl-planes .ap-gt { font-size: clamp(19px, 2.6vw, 22px); font-weight: 800; letter-spacing: -.03em; margin-top: 6px; }

/* Lo que incluye: lista grande con íconos dorados */
/* Una sola columna: con 2 × 2 el ítem de dos líneas desalineaba la grilla */
.ap-incluye { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
.ap-incluye li { display: flex; align-items: center; gap: 14px; font-size: 16px; line-height: 1.35; }
.ap-incluye svg { width: 34px; height: 34px; flex: none; color: var(--gold-ink); }

/* Tabla de planes */
.ap-tabla { display: flex; flex-direction: column; margin-top: 4px; }
/* Columnas de precio iguales y números alineados arriba: el de 1 mes y el de
   3 meses arrancan a la misma altura; «S/… al mes» cuelga debajo. */
.ap-cab, .ap-fila { display: grid; grid-template-columns: 1.6fr 1fr 1fr 150px; align-items: start; column-gap: 12px; }
.ap-cab { align-items: center; }
.ap-cab { font-size: 14px; font-weight: 700; padding: 0 14px 10px; border-bottom: 1px solid var(--hair); }
.ap-cab span:not(:first-child) { text-align: center; }
.ap-fila { position: relative; padding: 16px 14px; border-bottom: 1px solid var(--hair); }
.ap-fila--star { border: 1.5px solid var(--gold); border-radius: 10px; margin: 14px 0 4px; padding-top: 22px; }
.ap-tag { position: absolute; top: 0; left: 14px; transform: translateY(-50%); font-size: 12px; font-weight: 700; color: #fff; background: var(--gold-ink); border-radius: 99px; padding: 4px 11px; white-space: nowrap; }
.ap-plan { display: flex; flex-direction: column; gap: 4px; }
.ap-k { font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-ink); }
.ap-plan b { font-size: 17px; font-weight: 700; letter-spacing: -.02em; }
.ap-eval { align-self: flex-start; margin-top: 4px; font-size: 12.5px; font-weight: 700; color: var(--gold-ink); border: 1px solid var(--gold); border-radius: 99px; padding: 4px 11px; white-space: nowrap; }
.ap-precio { text-align: center; }
.ap-fila .ap-precio { padding-top: 22px; }
/* El botón se centra en la línea de los números, no en la fila (las filas con
   «+ 1 evaluación» son más altas y lo bajaban). */
.ap-fila .ap-cta { align-self: start; margin-top: 12px; }
.ap-sola .ap-cta { align-self: center; }
.ap-lbl { display: none; font-size: 12px; color: var(--muted); font-weight: 600; }
.ap-pr { display: block; font-weight: 800; font-size: 27px; letter-spacing: -.02em; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
.ap-cu { font-size: .62em; margin-right: 1px; }
.ap-eq { display: block; font-size: 13px; color: var(--muted); margin-top: 4px; }
.ajl-planes .ap-nota { border-left: 3px solid var(--gold); padding: 2px 0 2px 14px; font-size: 14.5px; color: var(--muted); line-height: 1.45; }
.ap-nota b { color: var(--ink); }

/* Una sola sesión */
.ap-sola { display: grid; grid-template-columns: 1.7fr 1.95fr 150px; align-items: center; column-gap: 12px; padding: 16px 14px; border-top: 1px solid var(--hair); border-bottom: 1px solid var(--hair); }
.ajl-planes .ap-sola h4 { font-size: 17px; font-weight: 700; color: #5C5C5C; }
.ajl-planes .ap-sola p { font-size: 14px; color: var(--muted); margin-top: 2px; }
.ap-sola .ap-pr { color: #5C5C5C; }

/* Botones: mismas clases que usa la medición (pbtn / pbtn--star / pbtn--ghost) */
.pbtn { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; padding: 10px 14px; border-radius: 10px; font-family: var(--ff); font-size: 14.5px; font-weight: 700; text-decoration: none; color: #fff; background: var(--ink); border: 1.5px solid var(--ink); transition: transform .15s ease; }
.pbtn--star { background: var(--gold-ink); border-color: var(--gold-ink); }
.pbtn--ghost { background: transparent; color: var(--ink); }
.pbtn:hover { transform: translateY(-1px); }
.pbtn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

/* Formas de pago */
.ap-pago { display: flex; flex-direction: column; gap: 10px; align-items: center; margin-top: 6px; }
.ap-pago-lab { font-size: 12px; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; }
.ap-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.ap-pills span { border: 1px solid #CFCFCF; border-radius: 10px; padding: 9px 18px; font-size: 15px; font-weight: 700; text-align: center; }
.ap-pills em { display: block; font-style: normal; font-size: 12px; font-weight: 500; color: var(--muted); }

/* Celular: cada plan se vuelve un bloque */
@media (max-width: 640px) {
  .ap-inner { padding: 40px 16px; }
  .ap-incluye { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .ap-incluye li { font-size: 15px; }
  .ap-incluye svg { width: 30px; height: 30px; }
  .ap-cab { display: none; }
  .ap-fila, .ap-sola { grid-template-columns: 1fr 1fr; row-gap: 12px; align-items: start; }
  .ap-plan, .ap-sola > div:first-child { grid-column: 1 / -1; }
  .ap-cta { grid-column: 1 / -1; }
  .ap-lbl { display: block; margin-bottom: 4px; }
  .ap-fila .ap-precio { padding-top: 0; }
  .ap-fila .ap-cta { margin-top: 0; }
  .ap-pr { font-size: 25px; }
  /* Cada paquete en su propia tarjeta; la recomendada conserva el borde dorado */
  .ap-tabla { gap: 14px; }
  .ap-fila { border: 1px solid var(--hair); border-radius: 10px; }
  .ap-fila--star { border: 1.5px solid var(--gold); margin: 10px 0 0; padding-top: 24px; }
}
@media (prefers-reduced-motion: reduce) {
  .pbtn { transition: none; }
  .pbtn:hover { transform: none; }
}
</style>
