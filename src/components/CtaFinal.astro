---
// ─── CTA final ──────────────────────────────────────────────────────────────
import { WA_FALLBACK_URL } from '../config.js';
---

<section id="section-cta-final" class="cta-final">
  <div class="container">
    <h2 class="cta-final__title">Aprende a comer de una vez. Sin dietas eternas, sin culpa.</h2>
    <p class="cta-final__sub">
      Da el primer paso hoy. Escríbenos y definimos juntos el plan correcto para tu vida real.
    </p>
    <a
      href={WA_FALLBACK_URL}
      class="cta-final__btn"
      data-wa-section="cta_final"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Escríbenos por WhatsApp
    </a>
  </div>
</section>

<style>
.cta-final {
  background: linear-gradient(160deg, var(--dorado) 0%, var(--dorado-osc) 100%);
  color: #ffffff;
  text-align: center;
  padding-block: var(--section-py);
}

.cta-final__title {
  font-size: clamp(1.8rem, 5vw, 2.7rem);
  font-weight: 700;
  line-height: 1.14;
  color: #ffffff;
  max-width: 720px;
  margin: 0 auto 1rem;
}

.cta-final__sub {
  font-size: clamp(1rem, 2.2vw, 1.15rem);
  color: rgba(255, 255, 255, 0.92);
  max-width: 600px;
  margin: 0 auto 2rem;
  line-height: 1.6;
}

.cta-final__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
  background: #ffffff;
  color: var(--dorado-osc);
  font-weight: 700;
  font-size: 1.05rem;
  padding: 1rem 2.25rem;
  border-radius: 999px;
  min-height: 54px;
  box-shadow: 0 10px 26px rgba(23, 60, 44, 0.18);
  transition: transform var(--transition), box-shadow var(--transition);
}

.cta-final__btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(23, 60, 44, 0.24);
}
</style>
