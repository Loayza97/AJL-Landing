---
// ─── Ubicación / mapa ───────────────────────────────────────────────────────
import { contacto } from '../data/contacto.js';
---

<section id="section-ubicacion" class="section bg-white ubicacion">
  <div class="container">
    <div class="ubi-head">
      <p class="label">Dónde estamos</p>
      <h2 class="title" style="margin-bottom: 0.75rem;">Visítanos en Lince</h2>
      <p class="subtitle">
        {contacto.direccion} · Atención presencial y virtual desde cualquier lugar del país.
      </p>
      <p class="subtitle ubi-horario">Horario de atención: {contacto.horario}</p>
    </div>

    <div class="mapa">
      <iframe
        src={contacto.maps.embed}
        title="Mapa: consultorio de AJL Nutrición en Lince, Lima"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <div class="ubi-cta">
      <a
        class="btn-outline"
        href={contacto.maps.ficha}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Cómo llegar al consultorio en Google Maps"
      >
        📍 Cómo llegar
      </a>
    </div>
  </div>
</section>

<style>
.bg-white { background: var(--verde-claro); }

.ubi-head { max-width: 680px; margin-bottom: 2.5rem; }

.ubi-horario { margin-top: 0.5rem; }

.mapa {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
  border: 1px solid #dfe8e1;
  background: var(--white);
}

.mapa iframe {
  display: block;
  width: 100%;
  height: 400px;
  border: 0;
}

.ubi-cta {
  text-align: center;
  margin-top: 1.75rem;
}

@media (max-width: 640px) {
  .mapa iframe { height: 300px; }
}
</style>
