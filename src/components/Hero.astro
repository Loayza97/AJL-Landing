---
import { contacto } from '../data/contacto.js';

// Señales de confianza above-the-fold (sin credenciales).
// "+800 pacientes" = redondeo conservador de ~820 DNI únicos en la base real.
const trust = [
  '+800 pacientes atendidos',
  'Consultorio en Lince, Lima',
  'Presencial y virtual',
];
---

<section id="section-hero" class="hero">
  <div class="container hero__inner">
    <h1 class="hero__title">
      Deja de hacer <span class="hero__tachar">dietas</span>.<br />
      <span class="hero__accent">Aprende a comer.</span>
    </h1>

    <div class="hero__cta-group">
      <a
        href="/reservar/"
        class="btn-primary"
        data-cta="hero_primary"
        aria-label="Quiero empezar: elegir mi plan y mi primera sesión"
      >
        Quiero empezar →
      </a>
      <p class="hero__cta-promise">Eliges tu plan y tu primera sesión, sin escribir por WhatsApp.</p>
    </div>

    <ul class="hero__trust" aria-label="Por qué confiar en AJL Nutrición">
      {trust.map(item => (
        <li class="hero__trust-item">{item}</li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Paralaje del fondo del hero: con el mouse (solo donde hay mouse) y al bajar.
  // Movimiento máximo ~12 px; se apaga si la persona pidió menos animaciones.
  const hero = document.getElementById('section-hero');
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let mx = 0, my = 0, pendiente = false;
    const aplicar = () => {
      pendiente = false;
      const scroll = Math.min(window.scrollY, hero.offsetHeight) * 0.08;
      hero.style.setProperty('--px', `${(mx * 12).toFixed(1)}px`);
      hero.style.setProperty('--py', `${(my * 8 + scroll).toFixed(1)}px`);
    };
    const pedir = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(aplicar); } };
    if (matchMedia('(pointer: fine)').matches) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        mx = (e.clientX - r.left) / r.width - 0.5;
        my = (e.clientY - r.top) / r.height - 0.5;
        pedir();
      });
      hero.addEventListener('pointerleave', () => { mx = 0; my = 0; pedir(); });
    }
    window.addEventListener('scroll', pedir, { passive: true });
  }
</script>

<style>
.hero {
  position: relative;
  overflow: hidden;
  background: var(--verde-osc);
  color: var(--white);
  /* Sin altura de pantalla completa: la sección siguiente tiene que asomar
     al cargar, para que se entienda que hay más abajo. */
  display: flex;
  align-items: center;
  padding-block: clamp(5rem, 7vw, 6rem) clamp(2rem, 4vw, 2.75rem);
}

/* Foto del equipo (desktop: horizontal) */
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  /* El hero es más apaisado que la foto: se ancla arriba para no cortar
     las cabezas (las caras están entre el 15 % y el 45 % del alto). */
  background: url('/equipo-desktop.jpg') center 15% / cover no-repeat;
  /* Paralaje suave: el script mueve --px/--py unos pocos píxeles con el mouse
     y al bajar; el scale evita que asomen los bordes. */
  transform: translate3d(var(--px, 0px), var(--py, 0px), 0) scale(1.06);
  will-change: transform;
}

/* Velo verde para legibilidad del texto + destello terracota.
   Más oscuro a la izquierda (donde va el texto), se aclara a la derecha
   para dejar ver al equipo. */
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(1200px 500px at 82% -10%, rgba(214, 138, 92, 0.20), transparent 60%),
    linear-gradient(95deg,
      rgba(23, 60, 44, 0.95) 0%,
      rgba(23, 60, 44, 0.86) 38%,
      rgba(23, 60, 44, 0.55) 72%,
      rgba(23, 60, 44, 0.35) 100%);
}

.hero__inner {
  position: relative;
  z-index: 1;
  max-width: 800px;
}

/* Móvil: foto vertical + velo más parejo (equipo arriba, texto legible) */
@media (max-width: 768px) {
  .hero::before {
    background-image: url('/equipo-mobile.jpg');
    /* Se sube la foto lo justo para que las cabezas queden arriba con un
       margen, sin cortar frentes. Las cabezas empiezan al ~22 % del alto de la
       foto (≈ 0,336 × ancho), así que el corrimiento se ata al ancho. */
    background-position: center calc(-30vw);
  }
  .hero::after {
    background:
      radial-gradient(700px 380px at 80% -8%, rgba(214, 138, 92, 0.16), transparent 60%),
      linear-gradient(180deg,
        rgba(23, 60, 44, 0.45) 0%,
        rgba(23, 60, 44, 0.72) 42%,
        rgba(23, 60, 44, 0.93) 100%);
  }
}

.hero__title {
  font-size: clamp(2.5rem, 7.5vw, 4.75rem);
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: -1.5px;
  margin-block: 1.25rem 1.75rem;
}

.hero__accent {
  color: var(--gold);
  display: block;
}

/* Mensaje animado: «dietas» se tacha con una línea dorada y después aparece
   «Aprende a comer.». Sin animaciones (prefers-reduced-motion) queda quieto. */
.hero__tachar { position: relative; white-space: nowrap; }
.hero__tachar::after {
  content: "";
  position: absolute;
  left: -2%;
  right: -2%;
  top: 55%;
  height: 0.09em;
  border-radius: 0.05em;
  background: var(--gold);
  transform: scaleX(0) rotate(-3deg);
  transform-origin: left center;
  animation: hero-tachar 0.55s cubic-bezier(.6, 0, .2, 1) 0.5s forwards;
}
.hero__accent { animation: hero-aparecer 0.6s ease-out 0.95s both; }
@keyframes hero-tachar { to { transform: scaleX(1) rotate(-3deg); } }
@keyframes hero-aparecer { from { opacity: 0; transform: translateY(0.35em); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) {
  .hero__tachar::after { animation: none; transform: scaleX(1) rotate(-3deg); }
  .hero__accent { animation: none; }
  .hero::before { transform: scale(1.06); }
}


.hero__cta-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1rem;
}

.hero__cta-promise {
  font-size: 0.9rem;
  font-weight: 600;
  font-style: italic;
  color: rgba(255, 255, 255, 0.75);
  margin-top: -0.4rem;
}

.hero__cta-secondary {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--gold);
  border-bottom: 1px solid rgba(212, 168, 67, 0.4);
  padding-bottom: 2px;
  transition: color var(--transition), border-color var(--transition);
}

.hero__cta-secondary:hover {
  color: var(--gold-dark);
  border-color: var(--gold);
}

/* Franja de confianza */
.hero__trust {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
  margin-top: 2rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(255, 255, 255, 0.16);
}

.hero__trust-item {
  position: relative;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: rgba(255, 255, 255, 0.72);
  padding-left: 1.1rem;
}

.hero__trust-item::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-size: 0.8rem;
  font-weight: 900;
}

@media (max-width: 480px) {
  .hero__trust { gap: 0.5rem 1.25rem; }
}


/* Pantallas de escritorio bajas (laptops de 720–800 px de alto): se compacta
   el hero para que asomen las tarjetas de «Así funciona». */
@media (min-width: 769px) and (max-height: 800px) {
  .hero { padding-block: 4.75rem 1.75rem; }
  .hero__title { font-size: clamp(2.5rem, 6vw, 4rem); margin-block: 1rem 1.25rem; }
  .hero__trust { margin-top: 1.5rem; }
}

/* Celular: el área visible real ronda los 700 px (iPhone con barras de
   Safari). Se compacta para que asomen los dibujos de «Así funciona». */
@media (max-width: 768px) {
  .hero { padding-block: 3.25rem 1.5rem; }
  .hero__title { margin-block: 0.75rem 1.25rem; }
  .hero .btn-primary { padding-block: 0.9rem; }
  .hero__cta-group { gap: 0.75rem; }
  .hero__cta-promise { display: none; }
  .hero__trust { margin-top: 1.25rem; padding-top: 1rem; gap: 0.35rem 1rem; }
}
</style>
