---
import { contacto } from '../data/contacto.js';

// Señales de confianza above-the-fold (sin credenciales).
// "+800 pacientes" = redondeo conservador de ~820 DNI únicos en la base real.
const trust = [
  '+800 pacientes atendidos',
  'Consultorio en Lince, Lima',
  'Presencial y virtual',
];
---

<section id="section-hero" class="hero">
  <div class="container hero__inner">
    <p class="label">AJL Nutrición · Nutrición para tu vida real</p>
    <h1 class="hero__title">
      Deja de hacer dietas.<br />
      <span class="hero__accent">Aprende a comer.</span>
    </h1>
    <p class="hero__sub">
      Con lo que ya comes en tus restaurantes, tu chamba, tus antojos en las
      porciones correctas. Te acompañamos hasta que aprendas a decidir solo. Los
      resultados llegan como un efecto secundario de tener una alimentación
      sostenible.
    </p>

    <div class="hero__cta-group">
      <a
        href="#section-packages"
        class="btn-primary"
        data-cta="hero_primary"
        aria-label="Ver los planes disponibles"
      >
        Ver los planes →
      </a>
      <p class="hero__cta-promise">Para que aprendas a ser dueño de tu alimentación.</p>
    </div>

    <ul class="hero__trust" aria-label="Por qué confiar en AJL Nutrición">
      {trust.map(item => (
        <li class="hero__trust-item">{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
.hero {
  position: relative;
  overflow: hidden;
  background: var(--verde-osc);
  color: var(--white);
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding-block: clamp(5rem, 10vw, 8rem);
}

/* Foto del equipo (desktop: horizontal) */
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background: url('/equipo-desktop.jpg') center / cover no-repeat;
}

/* Velo verde para legibilidad del texto + destello terracota.
   Más oscuro a la izquierda (donde va el texto), se aclara a la derecha
   para dejar ver al equipo. */
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(1200px 500px at 82% -10%, rgba(214, 138, 92, 0.20), transparent 60%),
    linear-gradient(95deg,
      rgba(23, 60, 44, 0.95) 0%,
      rgba(23, 60, 44, 0.86) 38%,
      rgba(23, 60, 44, 0.55) 72%,
      rgba(23, 60, 44, 0.35) 100%);
}

.hero__inner {
  position: relative;
  z-index: 1;
  max-width: 800px;
}

/* Móvil: foto vertical + velo más parejo (equipo arriba, texto legible) */
@media (max-width: 768px) {
  .hero::before {
    background-image: url('/equipo-mobile.jpg');
    background-position: center top;
  }
  .hero::after {
    background:
      radial-gradient(700px 380px at 80% -8%, rgba(214, 138, 92, 0.16), transparent 60%),
      linear-gradient(180deg,
        rgba(23, 60, 44, 0.45) 0%,
        rgba(23, 60, 44, 0.72) 42%,
        rgba(23, 60, 44, 0.93) 100%);
  }
}

.hero__title {
  font-size: clamp(2.5rem, 7.5vw, 4.75rem);
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: -1.5px;
  margin-block: 1.25rem 1.75rem;
}

.hero__accent {
  color: var(--gold);
  display: block;
}

.hero__sub {
  font-size: clamp(1rem, 2.5vw, 1.2rem);
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.75;
  max-width: 580px;
  margin-bottom: 2.5rem;
}

.hero__cta-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1rem;
}

.hero__cta-promise {
  font-size: 0.9rem;
  font-weight: 600;
  font-style: italic;
  color: rgba(255, 255, 255, 0.75);
  margin-top: -0.4rem;
}

.hero__cta-secondary {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--gold);
  border-bottom: 1px solid rgba(212, 168, 67, 0.4);
  padding-bottom: 2px;
  transition: color var(--transition), border-color var(--transition);
}

.hero__cta-secondary:hover {
  color: var(--gold-dark);
  border-color: var(--gold);
}

/* Franja de confianza */
.hero__trust {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
  margin-top: 3rem;
  padding-top: 1.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.16);
}

.hero__trust-item {
  position: relative;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: rgba(255, 255, 255, 0.72);
  padding-left: 1.1rem;
}

.hero__trust-item::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-size: 0.8rem;
  font-weight: 900;
}

@media (max-width: 480px) {
  .hero__trust { gap: 0.5rem 1.25rem; }
}
</style>
