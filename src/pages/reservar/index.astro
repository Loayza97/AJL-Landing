---
import Layout from '../../layouts/Layout.astro';
import { plans, monthlyPlans } from '../../data/plans.js';
import { duracionesDe, formatoSoles } from '../../data/duraciones.js';
import { condicionesSuscripcion } from '../../../server/suscripciones/calculo.mjs';
import { PAISES } from '../../data/telefono.js';
import { NOVEDADES_TEXTO, RESUMEN_CONDICIONES, RESUMEN_PRIVACIDAD } from '../../data/condiciones.js';
import '../../styles/reservar.css';

// Todo lo que trae cada plan, para el recuadro «Incluye» de la pantalla 2.
const ORDINAL = { 2: '2da', 3: '3ra', 4: '4ta', 5: '5ta' };
const incluyeDe = (p) => [
  ...p.consultasMes,
  ...(p.firstMonthEval ? [`${ORDINAL[p.sessionsPerMonth + 1]} sesión de evaluación al final de tu primer mes`] : []),
  p.sessionsPerMonth >= 4 ? '2 planes nutricionales en la app, ajustados a tu día a día' : 'Tu plan nutricional en la app, ajustado a tu día a día',
  'Seguimiento continuo por WhatsApp con el equipo de nutricionistas (L–V 9–18 h, S 9–13 h)',
  '2 clases en vivo por semana (miércoles con el equipo, domingos con Alejandro) y comunidad',
  ...(p.checkoutSummary.includes('Atención prioritaria') ? ['Atención prioritaria'] : []),
];

// Precio «desde» de cada plan (Joaquín, 2026-10-26): el mensual más bajo, el del paquete más largo.
const desdeMes = (id) => formatoSoles(Math.min(...duracionesDe(id).map((d) => d.porMes)));

const catalogo = {};
for (const p of monthlyPlans) {
  catalogo[p.id] = { nombre: p.name, mensual: true, incluye: incluyeDe(p),
    duraciones: duracionesDe(p.id).map((d) => ({ ...d, sus: condicionesSuscripcion(p.id, d.meses) })) };
}
catalogo.basico = { nombre: plans.basico.name, mensual: false, precio: plans.basico.price };
catalogo.evaluacion = { nombre: plans.evaluacion.name, mensual: false, precio: plans.evaluacion.price };

// Fecha de nacimiento en tres listas: más fácil que un calendario que abre en
// el año actual. Años de los 10 a los 100 años (lo que acepta validar-datos.js).
const DIAS = Array.from({ length: 31 }, (_, i) => i + 1);
const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const ANIO = new Date().getFullYear();
const ANIOS = Array.from({ length: 91 }, (_, i) => ANIO - 10 - i);

const VENTANAS = [
  ['condiciones', 'Condiciones del servicio', RESUMEN_CONDICIONES, '/condiciones/'],
  ['privacidad', 'Política de privacidad', RESUMEN_PRIVACIDAD, '/privacidad/'],
];
---
<Layout noindex title="Reserva tu primera sesión · AJL Nutrición">
  <main class="rs">
    <script is:inline type="application/json" id="catalogo" set:html={JSON.stringify(catalogo)} />

    <section class="rs-paso" data-paso="p1" hidden>
      <div class="rs-progreso"><span>Paso 1 de 4</span></div>
      <h1>¿Cómo quieres que te acompañemos?</h1>
      <p class="rs-lead">Elige cada cuánto te vemos. Entre sesión y sesión, nunca te quedas solo.</p>
      <div class="rs-bloque">
        <p class="rs-k">Planes con seguimiento continuo</p>
        <div class="rs-incluye">
          <b>Todos incluyen tu seguimiento entre sesiones</b>
          <ul>
            <li><b>Tu plan en la app</b><span>Ajustado a tu día a día, con opciones para comer fuera.</span></li>
            <li><b>Equipo por WhatsApp</b><span>Nutricionistas que te responden entre sesiones.</span></li>
            <li><b>2 clases en vivo por semana</b><span>Miércoles con el equipo, domingos con Alejandro.</span></li>
          </ul>
        </div>
        <div class="rs-planes">
          {monthlyPlans.map((p) => (
            <article class:list={['rs-plan', { 'rs-plan--star': p.highlight }]}>
              <header><b>{p.name}</b>{p.highlight && <span class="rs-badge">Recomendado</span>}</header>
              <p class="rs-desde"><small>desde</small><b>{desdeMes(p.id)}</b> <span>al mes</span></p>
              <ul class="rs-lista">
                <li>{p.sessionsPerMonth === 1 ? '1 sesión' : `${p.sessionsPerMonth} sesiones`} al mes con tu nutricionista</li>
                <li>Tu plan ajustado a tu día a día</li>
                <li>Tu seguimiento entre sesiones</li>
              </ul>
              {p.firstMonthEval && <p class="rs-regalo">{ORDINAL[p.sessionsPerMonth + 1]} sesión de evaluación al final de tu primer mes</p>}
              <button type="button" class:list={['rs-btn', { 'rs-btn--ghost': !p.highlight }]} data-producto={p.id}>Elegir</button>
            </article>
          ))}
        </div>
      </div>
      <p class="rs-k">Sin seguimiento continuo</p>
      <div class="rs-sueltas">
        <button type="button" class="rs-suelta" data-producto="basico"><span><b>Una sola sesión</b><small>Tu plan, sin seguimiento</small></span><span class="rs-ir"><b>{formatoSoles(plans.basico.price)}</b>Elegir ›</span></button>
        <button type="button" class="rs-suelta" data-producto="evaluacion"><span><b>Una evaluación</b><small>Se resta del plan ese día</small></span><span class="rs-ir"><b>{formatoSoles(plans.evaluacion.price)}</b>Elegir ›</span></button>
      </div>
    </section>

    <section class="rs-paso" data-paso="p2" hidden>
      <button type="button" class="rs-volver" data-volver="p1">‹ Cambiar acompañamiento</button>
      <div class="rs-progreso"><span>Paso 2 de 4</span></div>
      <h1>¿Por cuánto tiempo?</h1>
      <p class="rs-lead" id="p2-plan"></p>
      <div class="rs-duraciones" id="p2-opciones"></div>
      <div class="rs-consultas" id="p2-consultas"></div>
      <div class="rs-forma" id="p2-forma" hidden>
        <h2 id="p2-forma-t">¿Cómo quieres pagar?</h2>
        <div class="rs-formas" role="radiogroup" aria-labelledby="p2-forma-t">
          <label class="rs-forma-op"><input type="radio" name="forma" value="mensual"><span id="p2-mensual"></span></label>
          <label class="rs-forma-op"><input type="radio" name="forma" value="completo"><span id="p2-completo"></span></label>
        </div>
        <button type="button" class="rs-btn" id="p2-seguir" disabled>Elegir mi primera sesión ›</button>
      </div>
      <p class="rs-nota">Tu plazo empieza cuando recibes tu plan, no cuando pagas. No necesitas agendar todo ahora: eliges la primera cita y las demás las coordinas con tu nutricionista. Pagas con tarjeta o con Yape, sin recargo. Con pago completo y tarjeta de crédito puedes pagar en hasta 12 cuotas; si hay intereses, los cobra tu banco.</p>
    </section>

    <section class="rs-paso" data-paso="p3" hidden>
      <button type="button" class="rs-volver" data-volver="p1">‹ Volver</button>
      <div class="rs-progreso"><span>Paso 3 de 4</span></div>
      <h1>Elige tu primera sesión</h1>
      <div id="p3-selector"></div>
      <p class="rs-error" id="p3-error" role="alert"></p>
    </section>

    <section class="rs-paso" data-paso="p4" hidden>
      <button type="button" class="rs-volver" data-volver="p3">‹ Cambiar hora</button>
      <div class="rs-progreso"><span>Paso 4 de 4</span><span>Guardamos tu horario · <span class="rs-reloj" id="p4-reloj"></span></span></div>
      <h1>Datos de pago</h1>
      <div class="rs-resumen" id="p4-resumen"></div>
      <form id="p4-form" novalidate>
        <p class="rs-nota rs-nota--arriba">Los datos de quien hace el pago. Así Mercado Pago lo reconoce y lo aprueba más fácil.</p>
        <label for="f-nombres">Nombres</label>
        <input type="text" id="f-nombres" autocomplete="given-name" maxlength="60" required>
        <div class="rs-dos">
          <div><label for="f-paterno">Apellido paterno</label><input type="text" id="f-paterno" autocomplete="family-name" maxlength="60" required></div>
          <div><label for="f-materno">Apellido materno <small>(si tienes)</small></label><input type="text" id="f-materno" maxlength="60"></div>
        </div>
        <label for="f-doc">Documento · para tu comprobante</label>
        <div class="rs-doc">
          <select id="f-tipo-doc" aria-label="Tipo de documento">
            <option value="dni">DNI</option><option value="ce">Carné de Extranjería</option><option value="pasaporte">Pasaporte</option>
          </select>
          <input type="text" id="f-doc" inputmode="numeric" maxlength="8" required>
        </div>
        <label for="f-whatsapp">WhatsApp · aquí te escribimos si hace falta</label>
        <div class="rs-tel">
          <select id="f-pais" aria-label="Código de país">
            {PAISES.map(([bandera, nombre, codigo]) => <option value={codigo}>{bandera} {nombre} +{codigo}</option>)}
          </select>
          <input type="tel" id="f-whatsapp" autocomplete="tel-national" inputmode="tel" placeholder="9__ ___ ___" required>
        </div>
        <label for="f-email">Correo · aquí llega tu comprobante</label>
        <input type="email" id="f-email" autocomplete="email" required>

        <label class="rs-check rs-para-mi"><input type="checkbox" id="f-para-mi" checked> <span><b>La sesión es para mí</b><small>Desmárcala si pagas por tu hijo, tu mamá u otra persona.</small></span></label>

        <div id="f-yo">
        <label for="f-nac-dia" id="l-nacimiento">Tu fecha de nacimiento</label>
        <div class="rs-fecha" role="group" aria-labelledby="l-nacimiento">
          <select id="f-nac-dia" aria-label="Día" autocomplete="bday-day" required>
            <option value="">Día</option>
            {DIAS.map((d) => <option value={String(d).padStart(2, '0')}>{d}</option>)}
          </select>
          <select id="f-nac-mes" aria-label="Mes" autocomplete="bday-month" required>
            <option value="">Mes</option>
            {MESES.map((m, i) => <option value={String(i + 1).padStart(2, '0')}>{m}</option>)}
          </select>
          <select id="f-nac-anio" aria-label="Año" autocomplete="bday-year" required>
            <option value="">Año</option>
            {ANIOS.map((a) => <option value={String(a)}>{a}</option>)}
          </select>
        </div>
        </div>

        <fieldset class="rs-paciente" id="f-otro" hidden>
          <legend>¿Para quién es la sesión?</legend>
          <label for="f-pac-nombres">Nombres del paciente</label>
          <input type="text" id="f-pac-nombres" maxlength="60">
          <div class="rs-dos">
            <div><label for="f-pac-paterno">Apellido paterno</label><input type="text" id="f-pac-paterno" maxlength="60"></div>
            <div><label for="f-pac-materno">Apellido materno <small>(si tiene)</small></label><input type="text" id="f-pac-materno" maxlength="60"></div>
          </div>
        <label for="f-pac-nac-dia" id="l-pac-nacimiento">Fecha de nacimiento del paciente</label>
        <div class="rs-fecha" role="group" aria-labelledby="l-pac-nacimiento">
          <select id="f-pac-nac-dia" aria-label="Día" required>
            <option value="">Día</option>
            {DIAS.map((d) => <option value={String(d).padStart(2, '0')}>{d}</option>)}
          </select>
          <select id="f-pac-nac-mes" aria-label="Mes" required>
            <option value="">Mes</option>
            {MESES.map((m, i) => <option value={String(i + 1).padStart(2, '0')}>{m}</option>)}
          </select>
          <select id="f-pac-nac-anio" aria-label="Año" required>
            <option value="">Año</option>
            {ANIOS.map((a) => <option value={String(a)}>{a}</option>)}
          </select>
        </div>
          <label for="f-pac-doc">Documento del paciente</label>
          <div class="rs-doc">
            <select id="f-pac-tipo-doc" aria-label="Tipo de documento del paciente">
              <option value="dni">DNI</option><option value="ce">Carné de Extranjería</option><option value="pasaporte">Pasaporte</option>
            </select>
            <input type="text" id="f-pac-doc" inputmode="numeric" maxlength="8">
          </div>
          <label for="f-pac-email">Correo del paciente <small>(opcional · aquí le llega la invitación; si lo dejas vacío, te llega a ti)</small></label>
          <input type="email" id="f-pac-email">
        </fieldset>

        <label class="rs-check" id="l-acepto-sus" hidden><input type="checkbox" id="f-acepto-sus"> <span id="t-acepto-sus"></span></label>
        <label class="rs-check"><input type="checkbox" id="f-acepto" required> <span>Acepto las <button type="button" class="rs-link" data-ventana="condiciones">condiciones del servicio</button> y he leído la <button type="button" class="rs-link" data-ventana="privacidad">política de privacidad</button>.</span></label>
        <label class="rs-check"><input type="checkbox" id="f-novedades"> <span>{NOVEDADES_TEXTO.replace(/ \(v[\d-]+\)$/, '')} (opcional)</span></label>
        <p class="rs-nota">Mover tu cita es gratis hasta 48 h antes; después cuesta S/40.</p>
        <div class="rs-consejos">
          <b>Antes de pagar, para que pase a la primera</b>
          <ol>
            <li>Paga desde <b>tu</b> celular o computadora de siempre, con el wifi de tu casa o tus datos móviles. Evita redes ajenas o equipos prestados.</li>
            <li>Revisa en la app de tu banco que tu tarjeta tenga <b>activas las compras por internet</b> y cupo suficiente.</li>
            <li>Si tienes cuenta de Mercado Pago, <b>entra con ella</b> al pagar.<span id="p4-consejo-yape"> Si no, puedes pagar como invitado o con <b>Yape</b>.</span></li>
            <li>Si te sale rechazado, <b>no lo repitas enseguida</b>: te mostramos otras formas de pagar.</li>
          </ol>
          <p id="p4-solo-tarjeta" hidden>En pago mensual: solo tarjeta de crédito o débito (Yape no permite cobros automáticos).</p>
        </div>
        <p class="rs-aviso" id="p4-yape" hidden>¿Pagarás con Yape? Revisa tu límite en la app: este monto puede superarlo. Con tarjeta no hay límite.</p>
        <button type="submit" class="rs-btn" id="p4-pagar">Pagar</button>
        <p class="rs-cuotas">Con tarjeta de crédito, en hasta 12 cuotas</p>
        <p class="rs-error" id="p4-error" role="alert"></p>
      </form>
    </section>

    {VENTANAS.map(([id, titulo, puntos, ruta]) => (
      <dialog class="rs-modal" id={`ventana-${id}`} aria-labelledby={`ventana-${id}-t`}>
        <div class="rs-modal-cab">
          <h2 id={`ventana-${id}-t`}>{titulo}</h2>
          <button type="button" class="rs-cerrar" data-cerrar aria-label="Cerrar">×</button>
        </div>
        <div class="rs-modal-cuerpo">
          {puntos.map((p) => <div><b>{p.t}</b><p>{p.d}</p></div>)}
          <p>Versión completa: <a href={ruta} target="_blank" rel="noopener">ajlnutricion.com{ruta}</a></p>
        </div>
        <button type="button" class="rs-btn" data-cerrar>Entendido, volver a mis datos</button>
      </dialog>
    ))}
    <!-- Device ID de Mercado Pago (recomendación de soporte, 10-nov-2026): crea MP_DEVICE_SESSION_ID para el antifraude. -->
    <script is:inline src="https://www.mercadopago.com/v2/security.js" view="checkout" async></script>
  </main>
</Layout>

<script>
  import '../../scripts/reservar.js';
</script>
