---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import VideoComoTrabajamos from '../components/VideoComoTrabajamos.astro';
// «Así funciona» (HowItWorks.astro) salió de la portada el 2026-11-22: en su lugar va
// el video «cómo trabajamos». Para volver: importar ../components/HowItWorks.astro
// y poner <HowItWorks /> en lugar de <VideoComoTrabajamos />.
import Testimonials from '../components/Testimonials.astro';
import Plans from '../components/Plans.astro';
import PlanParejas from '../components/PlanParejas.astro';
import Evaluation from '../components/Evaluation.astro';
import FAQ from '../components/FAQ.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
// Newsletter (popup 10% OFF) apagado el 2026-10-16 a pedido del equipo. Para volver a
// mostrarlo: importar ../components/Newsletter.astro y poner <Newsletter /> abajo.
---

<Layout>
  <!-- Distribución:
       Hero → Video «cómo trabajamos» → Planes → Plan Parejas (Nuevo) → Testimonios → Evaluación → FAQ → Ubicación → CTA final → Footer -->
  <Hero />
  <VideoComoTrabajamos />
  <Plans />
  <PlanParejas />
  <Testimonials />
  <Evaluation />
  <FAQ />
  <Ubicacion />
  <CtaFinal />
  <Footer />
  <FloatingWhatsApp />
</Layout>
