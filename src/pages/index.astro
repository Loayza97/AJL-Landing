---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Plans from '../components/Plans.astro';
import Evaluation from '../components/Evaluation.astro';
import FAQ from '../components/FAQ.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Newsletter from '../components/Newsletter.astro';
---

<Layout>
  <!-- Distribución:
       Hero → Testimonios → Planes → Evaluación → FAQ → Ubicación → CTA final → Footer -->
  <Hero />
  <Testimonials />
  <Plans />
  <Evaluation />
  <FAQ />
  <Ubicacion />
  <CtaFinal />
  <Footer />
  <FloatingWhatsApp />
  <CookieBanner />
  <Newsletter />
</Layout>
