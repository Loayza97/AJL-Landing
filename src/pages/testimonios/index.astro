---
// ─── /testimonios: todos los clips en cuadrícula ────────────────────────────
// La landing en móvil manda aquí con un botón; los videos verticales a pantalla
// completa alargaban demasiado la página principal.
import Layout from '../../layouts/Layout.astro';
import Testimonials from '../../components/Testimonials.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
---

<Layout
  title="Testimonios de pacientes · AJL Nutrición"
  description="Pacientes reales de AJL Nutrición cuentan cómo cambiaron su relación con la comida. Nutricionista en Lince, Lima."
>
  <main>
    <div class="container tp-back">
      <a href="/">← Volver al inicio</a>
    </div>
    <Testimonials variant="page" />
    <section class="section tp-cta">
      <div class="container">
        <a href="/#section-packages" class="btn-primary">Ver los planes →</a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>

<style>
  .tp-back { padding-top: 1.5rem; background: var(--gray-light); }
  .tp-back a { font-weight: 600; color: var(--verde-osc); }
  .tp-cta { text-align: center; padding-block: 2.5rem; background: var(--gray-light); }
</style>
